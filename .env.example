# claire environment variables
# Copy this file to .env and fill in your values.

# ── Groq API (LLM + STT) ──────────────────────────────────────────────────
# Free tier: https://console.groq.com — 14,400 requests/day, no credit card
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Model ─────────────────────────────────────────────────────────────
# Default: openai/gpt-oss-20b (also supports llama-3.1-8b-instant, etc.)
LLM_MODEL=openai/gpt-oss-20b

# ── KittenTTS Configuration ───────────────────────────────────────────────
# Female voices: Bella, Luna, Rosie, Kiki
# Male voices: Jasper, Bruno, Hugo, Leo
TTS_VOICE=Luna
TTS_SPEED=1.20
TTS_MODEL=KittenML/kitten-tts-mini-0.8



